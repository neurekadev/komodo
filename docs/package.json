{
  "name": "komodo-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "serve out",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "check:links": "node scripts/validate-links.mjs",
    "check:static": "node scripts/validate-static-output.mjs",
    "verify": "yarn typecheck && yarn lint && yarn check:links && yarn build && yarn check:static"
  },
  "dependencies": {
    "cnfast": "0.1.0",
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.4",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "yarn@1.22.22"
}
