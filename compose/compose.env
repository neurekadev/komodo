# Komodo all-in-one installation settings
# Save this file as .env beside compose.yaml.
# Replace every CHANGE_ME value before the first start.

# Docker Compose keeps these names stable across upgrades.
COMPOSE_PROJECT_NAME=komodo
COMPOSE_KOMODO_IMAGE_TAG=3

# Public address and display settings.
KOMODO_HOST=https://komodo.example.com
KOMODO_TITLE=Komodo
TZ=Etc/UTC

# MongoDB or FerretDB credentials.
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Initial administrator account.
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Application secrets. Use different random values for each setting.
# For example: openssl rand -hex 32
KOMODO_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
KOMODO_WEBHOOK_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET

# The local Periphery container registers this Server automatically.
KOMODO_FIRST_SERVER_NAME=Local

# Docker's named-volume directory on the host.
# Run `docker info --format '{{.DockerRootDir}}/volumes'` if this is not correct.
PERIPHERY_DOCKER_VOLUME_ROOT=/var/lib/docker/volumes

# Common optional settings. See the configuration documentation for all options.
KOMODO_DISABLE_CONFIRM_DIALOG=false
PERIPHERY_DISABLE_TERMINALS=false
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
