# Standalone Periphery settings
# Save this file as .env beside the standalone compose.yaml.

# Keep the existing named-volume prefix and select the Komodo image release.
COMPOSE_PROJECT_NAME=komodo
COMPOSE_KOMODO_IMAGE_TAG=3

# Public Komodo Core address and the Server name shown in the UI.
PERIPHERY_CORE_ADDRESS=https://komodo.example.com
PERIPHERY_CONNECT_AS=my-server

# Create this key under Settings -> Onboarding, then remove it after connection.
PERIPHERY_ONBOARDING_KEY=O-CHANGE_ME

# Persist Periphery's identity and Core trust data in the named data volume.
PERIPHERY_PRIVATE_KEY=file:/data/keys/periphery.key
PERIPHERY_CORE_PUBLIC_KEYS=file:/data/keys/core.pub

# Docker's named-volume directory on this server.
# Run `docker info --format '{{.DockerRootDir}}/volumes'` if this is not correct.
PERIPHERY_DOCKER_VOLUME_ROOT=/var/lib/docker/volumes

# Common security and monitoring settings.
PERIPHERY_DISABLE_TERMINALS=false
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
